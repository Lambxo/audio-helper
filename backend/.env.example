# 复制本文件为 backend/.env 后填写真实值；.env 不会被提交到仓库。

# ------- 应用基础配置（本轮已生效） -------
APP_HOST=0.0.0.0
APP_PORT=8003
# 允许跨域访问的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5175

# 可选。不填则使用 backend/storage（绝对路径由程序计算）。
# STORAGE_DIR=
# 音频探测工具。探测不等于转码；需本机已安装 FFmpeg，并保证终端里能运行 ffprobe。
FFPROBE_PATH=ffprobe

# ------- 外部服务密钥（占位模板，本轮代码尚未读取） -------
# 百炼（Model Studio）API Key，统一北京地域，用于 ASR / TTS，
# 后续如确认通过百炼调用 DeepSeek，也会复用此密钥。
BAILIAN_API_KEY=
# 北京地域 ASR（DashScope 同步调用，旧域名仍可用，不需要 Workspace ID）
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
ASR_MODEL=qwen3-asr-flash
# 可选。不填则使用北京地域 DashScope 兼容模式地址（与 ASR 同一套 Key）。
# 若控制台要求业务空间专属域名，再填写 Workspace ID（形如 llm-xxxxx）。
BAILIAN_WORKSPACE_ID=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
# 说明：当前方案通过百炼调用 deepseek-v4-flash，鉴权使用 BAILIAN_API_KEY。
# DEEPSEEK_API_KEY 仅为占位，代码未读取。
DEEPSEEK_API_KEY=
# 高德 Web服务 API 类型 Key，用于 geocode/geo 与 place/around。
AMAP_API_KEY=
