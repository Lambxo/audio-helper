# 复制本文件为 backend/.env 后填写真实值；.env 不会被提交到仓库。

# ------- 应用基础配置（本轮已生效） -------
APP_HOST=0.0.0.0
APP_PORT=8003
# 允许跨域访问的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5175

# 可选。不填则使用 backend/storage（绝对路径由程序计算）。
# STORAGE_DIR=
# 音频探测工具。探测不等于转码；需本机已安装 FFmpeg，并保证终端里能运行 ffprobe。
FFPROBE_PATH=ffprobe

# ------- 外部服务密钥（占位模板，本轮代码尚未读取） -------
# 百炼（Model Studio）API Key，统一北京地域，用于 ASR / TTS，
# 后续如确认通过百炼调用 DeepSeek，也会复用此密钥。
BAILIAN_API_KEY=
# 百炼业务空间ID（调用 DeepSeek 系列模型的 OpenAI 兼容接口时需要）。
BAILIAN_WORKSPACE_ID=
# 说明：若最终确认 DeepSeek 通过百炼调用（复用 BAILIAN_API_KEY），
# 此变量可能不会被实际使用；是否保留以实现 /extract 时的确认结果为准。
DEEPSEEK_API_KEY=
# 高德 Web服务 API 类型 Key，用于 geocode/geo 与 place/around。
AMAP_API_KEY=
